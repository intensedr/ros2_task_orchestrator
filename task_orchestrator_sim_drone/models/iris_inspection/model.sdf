<?xml version="1.0"?>
<sdf version="1.11">
  <model name="iris_inspection">
    <static>true</static>
    <include>
      <name>airframe</name>
      <uri>model://iris_with_standoffs</uri>
    </include>
    <link name="front_camera_link">
      <pose relative_to="__model__">0.17 0 0.159923 0 0.523598776 0</pose>
      <visual name="camera_housing_visual">
        <pose relative_to="front_camera_link">0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.075 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.025 0.03 0.035 1</ambient>
          <diffuse>0.025 0.03 0.035 1</diffuse>
          <specular>0.18 0.18 0.18 1</specular>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose relative_to="front_camera_link">0.055 0 0 0 1.57079633 0</pose>
        <geometry>
          <cylinder>
            <radius>0.022</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.04 0.10 0.22 1</ambient>
          <diffuse>0.04 0.10 0.22 1</diffuse>
          <specular>0.18 0.18 0.18 1</specular>
        </material>
      </visual>
      <sensor name="front_rgb" type="camera">
        <pose relative_to="front_camera_link">0.058 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.08</near>
            <far>80.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <visualize>false</visualize>
        <topic>/drone/front_camera</topic>
      </sensor>
    </link>
    <frame name="front_camera_optical_frame" attached_to="front_camera_link">
      <pose relative_to="front_camera_link">0.058 0 0 -1.57079633 0 -1.57079633</pose>
    </frame>
  </model>
</sdf>
